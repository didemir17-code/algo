# ==========================================
# Gemini AI API Yapılandırması (Sunucu Tarafı)
# ==========================================
# Güvenlik: API anahtarı istemciye (frontend) ASLA sızdırılmamalıdır (NEXT_PUBLIC_ öneki KULLANILMAZ).
# Bu anahtar yalnızca sunucu tarafında (app/api/chat/route.ts) process.env.GEMINI_API_KEY üzerinden okunur.
#
# Yerel geliştirme için bu dosyayı .env.local olarak kopyalayın ve anahtarınızı ekleyin:
# cp .env.example .env.local

GEMINI_API_KEY=your_gemini_api_key_here

# Opsiyonel: Kullanılacak model (Varsayılan: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Uygulama Ana URL'si (Opsiyonel)
APP_URL=http://localhost:3000

# ==========================================
# PostgreSQL & Prisma Veritabanı Yapılandırması
# ==========================================
DATABASE_URL="postgres://username:password@host:5432/database?sslmode=require"
POSTGRES_URL="postgres://username:password@host:5432/database?sslmode=require"
PRISMA_DATABASE_URL="postgres://username:password@host:5432/database?sslmode=require"

# JWT Gizli Anahtarı
JWT_SECRET="your-super-secret-jwt-key"
